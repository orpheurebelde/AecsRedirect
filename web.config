<?xml version="1.0" encoding="utf-8"?>
<!--
  Pasta temporaria para recrutamento.cm-gaia.pt.
  Contem tres versoes, selecionadas numa unica linha no rewriteMap ModoAtivo:
  - informacao: index.html, aviso temporario sem redirecionamento
  - redirecionamento: index-redirecionamento.html, aviso com redirecionamento
  - manutencao: index-manutencao.html, aviso de manutencao

  Para trocar a pagina ativa, editar apenas value na entrada key="ativa".
  Fica FORA do repositorio e nao pertence a nenhum projeto do Visual Studio.
  Pode ser partilhada por varias aplicacoes do IIS ao mesmo tempo.

  Os caminhos abaixo sao RELATIVOS de proposito, para funcionar tanto na
  raiz de um site como numa aplicacao dentro de um site, por exemplo
  /cmgaecs_frontdesk ou /cmgconcursos.
-->
<configuration>
  <system.webServer>

    <!-- Reserva para IIS sem URL Rewrite. Com URL Rewrite, a regra abaixo
         interceta tambem o pedido a raiz e seleciona a pagina ativa. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Qualquer endereco pedido mostra o aviso, sem mudar o URL na barra.
         O <clear /> e essencial: descarta as regras herdadas do site pai,
         incluindo as regras RemoveASPX e AddASPX das outras aplicacoes. -->
    <rewrite>
      <rewriteMaps>
        <!-- UNICO SWITCH: informacao | redirecionamento | manutencao -->
        <rewriteMap name="ModoAtivo" defaultValue="informacao">
          <add key="ativa" value="informacao" />
        </rewriteMap>
        <rewriteMap name="PaginaPorModo" defaultValue="index.html">
          <add key="informacao" value="index.html" />
          <add key="redirecionamento" value="index-redirecionamento.html" />
          <add key="manutencao" value="index-manutencao.html" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <clear />
        <rule name="AvisoParaTudo" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="{PaginaPorModo:{ModoAtivo:ativa}}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Rede de seguranca, caso o modulo URL Rewrite nao esteja instalado. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="index.html" responseMode="File" />
    </httpErrors>

    <!-- Sem cache, para que a troca de pagina seja imediata. -->
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
