<?xml version="1.0" encoding="utf-8"?>
<!--
  Pasta de aviso de mudanca de endereco para recrutamento.cm-gaia.pt
  Fica FORA do repositorio e nao pertence a nenhum projeto do Visual Studio.
  Pode ser partilhada por varias aplicacoes do IIS ao mesmo tempo.

  Os caminhos abaixo sao RELATIVOS de proposito, para funcionar tanto na
  raiz de um site como numa aplicacao dentro de um site, por exemplo
  /cmgaecs_frontdesk ou /cmgconcursos.
-->
<configuration>
  <system.webServer>

    <!-- A pagina de aviso e o documento por omissao. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Qualquer endereco pedido mostra o aviso, sem mudar o URL na barra.
         O <clear /> e essencial: descarta as regras herdadas do site pai,
         incluindo as regras RemoveASPX e AddASPX das outras aplicacoes. -->
    <rewrite>
      <rules>
        <clear />
        <rule name="AvisoParaTudo" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Rede de seguranca, caso o modulo URL Rewrite nao esteja instalado. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="index.html" responseMode="File" />
    </httpErrors>

    <!-- Sem cache, para que a passagem posterior a 301 seja imediata. -->
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
